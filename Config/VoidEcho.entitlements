<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Void Echo is sandboxed. A meeting is a Jitsi page in a WKWebView: it needs the network
	(outgoing only: Void Echo never listens), the camera and the microphone. Both the App Sandbox
	and the Hardened Runtime refuse the camera and the microphone, without even asking, when these
	entitlements are missing. Screen sharing needs no entitlement: macOS asks through its own picker.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
